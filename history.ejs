<%- include('partial-header', { title: 'Full Result History' }) %>

<% if (typeof siteOrigin !== 'undefined' && siteOrigin) { %>
<script type="application/ld+json"><%- JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": siteOrigin + "/" },
    { "@type": "ListItem", "position": 2, "name": "Full Result History", "item": siteOrigin + "/history" },
  ],
}) %></script>
<% } %>

<a class="back-link" href="/"><%= t('historyBackLatest') %></a>
<h1><%= t('historyHeading') %></h1>
<p class="subtitle"><%= t('historySubtitle') %></p>

<form class="form-box" method="GET" action="/history" style="margin-bottom:24px;">
  <label for="lottery"><%= t('filterLotteryLabel') %></label>
  <select id="lottery" name="lottery">
    <option value=""><%= t('filterAllLotteries') %></option>
    <% allLotteries.forEach(function(l) { %>
      <option value="<%= l.slug %>" <%= selectedSlug === l.slug ? 'selected' : '' %>><%= l.name %></option>
    <% }); %>
  </select>

  <label for="from"><%= t('filterFromLabel') %></label>
  <input type="date" id="from" name="from" value="<%= fromDate %>" />

  <label for="to"><%= t('filterToLabel') %></label>
  <input type="date" id="to" name="to" value="<%= toDate %>" />

  <button type="submit"><%= t('filterButton') %></button>
  <% if (selectedSlug || fromDate || toDate) { %>
    <a class="back-link" style="display:block; margin-top:10px;" href="/history"><%= t('clearFilters') %></a>
  <% } %>
</form>

<% if (lotteries.length === 0) { %>
  <div class="empty-state"><%= t('historyEmptyNoLotteries') %></div>
<% } else if (rows.length === 0) { %>
  <div class="empty-state"><%= t('historyEmptyNoMatch') %></div>
<% } else { %>
  <div class="freeze-grid" id="freezeGrid">
    <div class="freeze-corner"><%= t('colDate') %></div>
    <div class="freeze-header-scroll" id="freezeHeaderScroll">
      <div class="freeze-header-row">
        <% lotteries.forEach(function(lottery) { %>
          <div class="freeze-header-cell"><%= lottery.name %></div>
        <% }); %>
      </div>
    </div>
    <div class="freeze-dates-scroll" id="freezeDatesScroll">
      <% rows.forEach(function(row) { %>
        <div class="freeze-date-cell"><%= row.dateLabel %></div>
      <% }); %>
    </div>
    <div class="freeze-body-scroll" id="freezeBodyScroll">
      <% rows.forEach(function(row) { %>
        <div class="freeze-body-row">
          <% row.cells.forEach(function(cell) { %>
            <div class="freeze-body-cell"><%= cell %></div>
          <% }); %>
        </div>
      <% }); %>
    </div>
  </div>

  <script>
    (function () {
      var body = document.getElementById('freezeBodyScroll');
      var header = document.getElementById('freezeHeaderScroll');
      var dates = document.getElementById('freezeDatesScroll');
      if (!body || !header || !dates) return;
      body.addEventListener('scroll', function () {
        header.scrollLeft = body.scrollLeft;
        dates.scrollTop = body.scrollTop;
      }, { passive: true });
    })();
  </script>
<% } %>

<%- include('partial-footer') %>

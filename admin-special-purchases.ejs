<%- include('partial-header', { title: 'Purchases - ' + lottery.name , isAdminPage: true }) %>

<a class="back-link" href="/admin/special">&larr; Special Lottery</a>
<h1><%= lottery.name %> <span class="tag tag-soft">Special</span></h1>
<p class="subtitle">Current round's ticket purchases. Numbers 000–999.</p>

<% if (typeof flash !== 'undefined' && flash) { %>
  <div class="flash-msg">✓ <%= flash %></div>
<% } %>

<a class="btn secondary" style="margin:12px 0 20px;" href="/admin/special/lottery/<%= lottery.id %>/purchases/export.csv">Export Ticket Records as CSV</a>

<div class="card" id="quickAdminEntry" data-lottery-id="<%= lottery.id %>" data-digits="3">
  <h2>Quick Ticket Entry</h2>
  <p class="subtitle">Numbers × amount for <%= lottery.name %> — e.g. <code>123,456,789×75</code>. You can still name a different special lottery after the amount to send it there instead.</p>
  <div class="quick-entry-row">
    <input type="text" id="quickAdminInput" placeholder="123,456,789×75" autocomplete="off">
    <button type="button" class="btn primary" id="quickAdminSubmit">Add</button>
  </div>
  <div class="error-msg" id="quickAdminError" style="display:none;"></div>
  <form method="POST" id="quickAdminForm" action="/admin/special/quick-purchase" style="display:none;">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <input type="hidden" name="lotteryId" id="quickAdminLotteryId" value="<%= lottery.id %>">
    <input type="hidden" name="amount" id="quickAdminAmount">
    <div id="quickAdminNumbersInputs"></div>
  </form>
</div>
<script type="application/json" id="quickAdminLotteriesData"><%- JSON.stringify((allSpecialLotteries || []).map(function(l){return {id:l.id, name:l.name};})) %></script>
<script src="/admin-quick-entry.js" defer></script>

<h2 style="margin-top:28px;">Current Round — by Number</h2>
<% if (rows.length === 0) { %>
  <div class="empty-state">No purchases logged for this round yet.</div>
<% } else { %>
  <div class="table-scroll-wrap">
  <table>
    <thead><tr><th>Number</th><th>Tickets</th><th>Amount</th></tr></thead>
    <tbody>
      <% rows.forEach(function(r) { %>
        <tr>
          <td class="result-cell"><%= r.number %></td>
          <td><%= r.tickets %></td>
          <td><%= r.amount %></td>
        </tr>
      <% }); %>
    </tbody>
    <tfoot>
      <tr style="font-weight:800;"><td>Total</td><td><%= totals.tickets %></td><td><%= totals.amount %></td></tr>
    </tfoot>
  </table>
  </div>
<% } %>

<%- include('partial-footer') %>

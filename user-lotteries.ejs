<%- include('partial-header', { title: 'Choose Lottery' }) %>
<div class="container">
  <div class="page-back"><a href="/account">← Back to Dashboard</a></div>
  <div class="top-actions">
    <div><h1 style="margin:0;">Lotteries</h1><p class="subtitle">Choose a lottery to open its 00–99 number chart.</p></div>
  </div>

  <div class="lottery-choice-grid">
    <a class="lottery-choice-card none-choice" href="/account/lotteries?selected=none">
      <strong>None</strong><span>Keep the number chart closed</span>
    </a>
    <% lotteries.forEach(lottery => { %>
      <a class="lottery-choice-card <%= selectedId === lottery.id ? 'selected' : '' %>" href="/account/numbers/<%= lottery.id %>">
        <strong><%= lottery.name %></strong>
        <span><%= lottery.ticketStatus && lottery.ticketStatus.locked ? '🔒 Ticket entry closed' : '🟢 Ticket entry open' %></span>
        <% if (lottery.drawTime) { %><span><%= lottery.drawTime %></span><% } else { %><span>Open number chart</span><% } %>
      </a>
    <% }) %>
  </div>

  <% if (selectedId === 'none' || !selectedId) { %>
    <div class="card clean-empty-card"><p class="empty-state">No lottery selected. Choose one above when you are ready.</p></div>
  <% } %>
</div>
<%- include('partial-footer') %>

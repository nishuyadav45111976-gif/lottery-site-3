<%- include('partial-header', { title: user.name + ' — Purchased Numbers' , isAdminPage: true }) %>

<div class="page-back"><a href="/admin/users">← Back to User Accounts</a></div>
<div class="top-actions">
  <div>
    <h1 style="margin:0;"><%= user.name %></h1>
    <p class="subtitle">Personal ID: <strong><%= user.userCode %></strong> · <%= user.active ? 'Active' : 'Disabled' %></p>
  </div>
  <a class="btn secondary" href="/admin">Admin Dashboard</a>
</div>

<div class="card">
  <h2>Ticket purchase summary</h2>
  <p class="subtitle">Numbers this account has bought tickets for, with the total tickets and amount recorded on each number.</p>
  <div class="user-detail-summary">
    <div><strong><%= purchasedCount %></strong><span>Numbers bought</span></div>
    <div><strong><%= totalTickets %></strong><span>Total tickets</span></div>
    <div><strong><%= totalAmount %></strong><span>Total amount</span></div>
  </div>
</div>

<% if (!lotteryViews.length) { %>
  <div class="empty-state">No lotteries have been created yet.</div>
<% } else { %>
  <% lotteryViews.forEach(function(lottery) { %>
    <% var purchasedNumbers = lottery.numbers.filter(function(n) { return lottery.byNumber[n].tickets > 0; }); %>
    <div class="card">
      <div class="section-head-row">
        <div>
          <h2 style="margin:0;"><%= lottery.name %></h2>
          <p class="subtitle" style="margin-bottom:0;"><%= purchasedNumbers.length %> number<%= purchasedNumbers.length === 1 ? '' : 's' %> purchased</p>
        </div>
        <button type="button" class="btn secondary toggle-numbers-btn" data-target="numbers-<%= lottery.id %>" <%= !purchasedNumbers.length ? 'disabled' : '' %>>View numbers</button>
      </div>

      <div class="admin-user-number-grid" id="numbers-<%= lottery.id %>" style="display:none;">
        <% if (!purchasedNumbers.length) { %>
          <p class="subtitle">No numbers purchased yet.</p>
        <% } %>
        <% purchasedNumbers.forEach(function(n) { %>
          <div class="admin-user-number-box followed">
            <span class="admin-user-number-label"><%= n %></span>
            <span class="admin-user-number-meta"><%= lottery.byNumber[n].tickets %> tkt<%= lottery.byNumber[n].tickets === 1 ? '' : 's' %></span>
            <% if (lottery.byNumber[n].amount > 0) { %><span class="admin-user-number-meta"><%= lottery.byNumber[n].amount %></span><% } %>
          </div>
        <% }); %>
      </div>
    </div>
  <% }); %>
<% } %>

<script>
  document.querySelectorAll('.toggle-numbers-btn').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var target = document.getElementById(btn.dataset.target);
      if (!target) return;
      var isHidden = target.style.display === 'none';
      target.style.display = isHidden ? 'grid' : 'none';
      btn.textContent = isHidden ? 'Hide numbers' : 'View numbers';
    });
  });
</script>

<%- include('partial-footer') %>

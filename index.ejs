<%- include('partial-header', { title: siteName }) %>

<h1><%= siteName %></h1>
<p class="subtitle"><%= t('tagline') %></p>
<% if (lastUpdated) { %>
  <p class="subtitle" style="font-size:0.82rem; margin-top:-8px;"><%= t('lastUpdatedLabel') %>: <%= lastUpdated %></p>
<% } %>


<% if (starredLottery) { %>
  <div class="featured-box">
    <div class="featured-label">⭐ <%= t('featuredLabel') %></div>
    <div class="featured-name"><%= starredLottery.name %></div>
    <% if (starredLottery.drawTime) { %><div class="featured-time"><%= starredLottery.drawTime %></div><% } %>
    <div class="featured-result <%= starredLottery.latestResult ? '' : 'pending' %>">
      <%= starredLottery.latestResult ? starredLottery.latestResult.resultText : 'Result pending' %>
      <% if (starredLottery.latestResult) { %><span class="featured-date"><%= starredLottery.latestResult.date %></span><% } else if (starredLottery.upcoming) { %>
        <span class="featured-date"><%= starredLottery.upcoming.pendingResult ? '' : 'Today · ' + starredLottery.upcoming.remainingText + ' left' %></span>
      <% } %>
    </div>
  </div>
<% } %>

<% if (mainLotteries.length > 0) { %>
  <h2 style="margin-top:28px;"><%= t('mainResultsHeading') %></h2>
  <div class="card-grid main-results-grid">
    <% mainLotteries.forEach(function(lottery) { %>
      <a class="lottery-card main-result-card" href="/lottery/<%= lottery.slug %>">
        <div class="name"><%= lottery.name %></div>
        <% if (lottery.latestResult) { %>
          <div class="result"><%= lottery.latestResult.resultText %></div>
          <div class="date">Latest · <%= lottery.latestResultDateLabel %></div>
        <% } else if (lottery.upcoming) { %>
          <div class="no-result"><%= lottery.upcoming.pendingResult ? 'Result pending' : ('Upcoming · ' + lottery.upcoming.drawTime) %></div>
        <% } else { %>
          <div class="no-result"><%= t('noResultYet') %></div>
        <% } %>
      </a>
    <% }); %>
  </div>
<% } %>

<% if (lotteries.length === 0) { %>
  <div class="empty-state"><%= t('emptyLotteries') %></div>
<% } else { %>
  <% if (lotteries.length > 5) { %>
    <input type="text" id="lotterySearch" class="search-box" placeholder="<%= t('searchPlaceholder') %>" onkeyup="filterLotteryTable()" style="margin-top:24px;" />
  <% } %>
  <div class="table-scroll-wrap">
  <table id="lotteryTable">
    <thead>
      <tr>
        <th><%= t('tableLottery') %></th>
        <th><%= typeof previousColumnLabel !== 'undefined' ? previousColumnLabel : t('tablePrevious') %></th>
        <th><%= typeof latestColumnLabel !== 'undefined' ? latestColumnLabel : t('tableLatest') %></th>
      </tr>
    </thead>
    <tbody>
      <% lotteries.forEach(function(lottery) { %>
        <tr class="<%= lottery.starLottery ? 'highlight-row' : '' %>" data-name="<%= lottery.name.toLowerCase() %>">
          <td>
            <a class="lottery-link" href="/lottery/<%= lottery.slug %>">
              <%= lottery.starLottery ? '⭐ ' : '' %><%= lottery.name %>
            </a>
          </td>
          <td class="result-cell">
            <%= lottery.previousResult ? lottery.previousResult.resultText : 'XX' %>
          </td>
          <td class="result-cell">
            <%= lottery.latestResult ? lottery.latestResult.resultText : 'XX' %>
          </td>
        </tr>
      <% }); %>
    </tbody>
  </table>
  </div>
  <div id="noSearchResults" class="empty-state" style="display:none;"><%= t('noSearchResults') %></div>
<% } %>

<% if (recentRows.length > 0) { %>
  <h2 style="margin-top:32px;"><%= t('last15Heading') %></h2>
  <p class="subtitle"><%= t('last15Sub') %></p>

  <div class="freeze-grid" id="freezeGrid">
    <div class="freeze-corner"><%= t('colDate') %></div>
    <div class="freeze-header-scroll" id="freezeHeaderScroll">
      <div class="freeze-header-row">
        <% lotteries.forEach(function(lottery) { %>
          <div class="freeze-header-cell"><%= lottery.name %></div>
        <% }); %>
      </div>
    </div>
    <div class="freeze-dates-scroll" id="freezeDatesScroll">
      <% recentRows.forEach(function(row) { %>
        <div class="freeze-date-cell"><%= row.dateLabel %></div>
      <% }); %>
    </div>
    <div class="freeze-body-scroll" id="freezeBodyScroll">
      <% recentRows.forEach(function(row) { %>
        <div class="freeze-body-row">
          <% row.cells.forEach(function(cell) { %>
            <div class="freeze-body-cell"><%= cell %></div>
          <% }); %>
        </div>
      <% }); %>
    </div>
  </div>

  <script>
    (function () {
      var body = document.getElementById('freezeBodyScroll');
      var header = document.getElementById('freezeHeaderScroll');
      var dates = document.getElementById('freezeDatesScroll');
      if (!body || !header || !dates) return;
      // The body is the only surface the user actually drags/swipes — the
      // header strip only ever moves sideways (mirroring body's horizontal
      // scroll) and the dates strip only ever moves up/down (mirroring
      // body's vertical scroll), so each one stays fixed on the axis it's
      // not supposed to move on.
      body.addEventListener('scroll', function () {
        header.scrollLeft = body.scrollLeft;
        dates.scrollTop = body.scrollTop;
      }, { passive: true });
    })();
  </script>
<% } %>

<p class="subtitle" style="margin-top:20px;"><a class="back-link" href="/history"><%= t('viewFullHistory') %></a></p>

<% if (typeof homeContentEnabled !== 'undefined' && homeContentEnabled && homeContentBody) { %>
  <div class="card home-content-block" style="margin-top:20px;">
    <% if (homeContentTitle) { %><h2><%= homeContentTitle %></h2><% } %>
    <p style="white-space:pre-wrap; color:var(--text-dim); margin:0;"><%= homeContentBody %></p>
  </div>
<% } %>

<% if (lotteries.length > 5) { %>
<script>
  function filterLotteryTable() {
    var query = document.getElementById('lotterySearch').value.trim().toLowerCase();
    var rows = document.querySelectorAll('#lotteryTable tbody tr');
    var visibleCount = 0;
    rows.forEach(function (row) {
      var match = row.getAttribute('data-name').indexOf(query) !== -1;
      row.style.display = match ? '' : 'none';
      if (match) visibleCount++;
    });
    document.getElementById('noSearchResults').style.display = visibleCount === 0 ? 'block' : 'none';
  }
</script>
<% } %>

<script>
  (function () {
    var wasHidden = false;
    document.addEventListener('visibilitychange', function () {
      if (document.visibilityState === 'hidden') {
        wasHidden = true;
      } else if (document.visibilityState === 'visible' && wasHidden) {
        location.reload();
      }
    });
  })();
</script>

<%- include('partial-footer') %>

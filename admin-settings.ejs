<%- include('partial-header', { title: 'Website Settings' , isAdminPage: true }) %>

<a class="back-link" href="/admin">&larr; Dashboard</a>
<h1>Website Settings</h1>
<p class="subtitle">Contact details shown on the site. Looking for the website name, Disclaimer, Privacy Policy, or About page? Those moved to <a href="/admin/pages">Edit Pages</a>.</p>

<% if (typeof flash !== 'undefined' && flash) { %>
  <div class="flash-msg">✓ <%= flash %></div>
<% } %>

<% if (error) { %>
  <div class="error-msg"><%= error %></div>
<% } %>

<form class="form-box" method="POST" action="/admin/settings"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <label for="contactLabel">Contact Bar Label</label>
  <input type="text" id="contactLabel" name="contactLabel" value="<%= currentContactLabel %>" placeholder="Help & Queries" />

  <label for="contactNumber">Contact Number</label>
  <input type="tel" id="contactNumber" name="contactNumber" value="<%= currentContactNumber %>" placeholder="e.g. +91 98765 43210" pattern="[0-9+\s\-]{10,20}" title="10-15 digits, plus optional +, spaces, or dashes" />
  <p class="subtitle" style="margin-top:6px; font-size:0.82rem;">Shown highlighted at the bottom of every page. Leave the number blank to hide it.</p>

  <label for="contactType">When tapped, this number should</label>
  <select id="contactType" name="contactType">
    <option value="call" <%= currentContactType === 'call' ? 'selected' : '' %>>Make a phone call</option>
    <option value="whatsapp" <%= currentContactType === 'whatsapp' ? 'selected' : '' %>>Open WhatsApp chat</option>
  </select>

  <button type="submit">Save Settings</button>
</form>

<h1 style="margin-top:36px;">WhatsApp Personal-Record Inbox</h1>
<p class="subtitle">Configure the dedicated WhatsApp Business number used for the personal-record inbox. For testing, you can temporarily enter your own number here. The number is stored as configuration only; WhatsApp API credentials stay in environment variables.</p>
<form class="form-box" method="POST" action="/admin/settings/whatsapp"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <label for="whatsappBusinessNumber">Dedicated WhatsApp Business Number</label>
  <input type="tel" id="whatsappBusinessNumber" name="whatsappBusinessNumber" value="<%= whatsappBusinessNumber %>" placeholder="+91 98765 43210" pattern="[0-9+\s\-]{10,20}" />
  <label for="whatsappTestNumber">Testing Sender Number</label>
  <input type="tel" id="whatsappTestNumber" name="whatsappTestNumber" value="<%= whatsappTestNumber %>" placeholder="Your personal WhatsApp number" pattern="[0-9+\s\-]{10,20}" />
  <div class="mode-switch" style="margin:12px 0;">
    <button type="submit" name="enabled" value="off" class="<%= !whatsappRecordsEnabled ? 'active' : '' %>">Off</button>
    <button type="submit" name="enabled" value="on" class="<%= whatsappRecordsEnabled ? 'active' : '' %>">On</button>
  </div>
  <button type="submit">Save WhatsApp Settings</button>
</form>

<h1 style="margin-top:36px;">Homepage Text Block</h1>
<p class="subtitle">A block of your own text shown near the bottom of the homepage, above the contact bar — good for keywords, area names, or anything else you want visitors (and search engines) to see. Leave it off if you don't need it.</p>

<form method="POST" action="/admin/home-content" id="homeContentToggleForm">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <input type="hidden" name="title" value="<%= homeContentTitle %>">
  <input type="hidden" name="body" value="<%= homeContentBody %>">
  <div class="mode-switch" style="margin-bottom:16px;">
    <button type="submit" name="enabled" value="off" class="<%= !homeContentEnabled ? 'active' : '' %>">Off</button>
    <button type="submit" name="enabled" value="on" class="<%= homeContentEnabled ? 'active' : '' %>">On</button>
  </div>
</form>

<form class="form-box" method="POST" action="/admin/home-content">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <input type="hidden" name="enabled" value="<%= homeContentEnabled ? 'on' : 'off' %>">

  <label for="homeTitle">Title (optional)</label>
  <input type="text" id="homeTitle" name="title" value="<%= homeContentTitle %>" maxlength="100" />

  <label for="homeBody">Text</label>
  <textarea id="homeBody" name="body" rows="5" maxlength="2000"><%= homeContentBody %></textarea>

  <button type="submit">Save Homepage Text</button>
</form>

<h1 style="margin-top:36px;">Change Admin Password</h1>
<p class="subtitle">Update the password used to log into this admin panel. You'll be logged out afterwards and need to sign in again.</p>

<% if (passwordError) { %>
  <div class="error-msg"><%= passwordError %></div>
<% } %>

<form class="form-box" method="POST" action="/admin/settings/password"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <label for="currentPassword">Current Password</label>
  <input type="password" id="currentPassword" name="currentPassword" required />

  <label for="newPassword">New Password</label>
  <input type="password" id="newPassword" name="newPassword" required minlength="8" />
  <p class="subtitle" style="margin-top:6px; font-size:0.82rem;">At least 8 characters.</p>

  <label for="confirmPassword">Confirm New Password</label>
  <input type="password" id="confirmPassword" name="confirmPassword" required minlength="8" />

  <button type="submit">Change Password</button>
</form>

<h1 style="margin-top:36px;">Admin 2FA</h1>
<p class="subtitle">Authenticator-based two-factor authentication is optional. When enabled, admin sign-in requires your authenticator code.</p><a class="btn secondary" href="/admin/settings/2fa">View 2FA Status</a>

<h1 style="margin-top:36px;">Backup Your Data</h1>
<p class="subtitle">Download everything on this site — lotteries, results, and ticket purchase records — as a single file you can keep for yourself.</p>
<a class="btn secondary" href="/admin/settings/backup">Download Backup</a>

<%- include('partial-footer') %>

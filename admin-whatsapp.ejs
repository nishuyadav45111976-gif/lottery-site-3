<%- include('partial-header', { title: 'WhatsApp Personal Records', isAdminPage: true }) %>
<a class="back-link" href="/admin">&larr; Dashboard</a>
<h1>WhatsApp Personal-Record Inbox</h1>
<p class="subtitle">This inbox receives messages through the official WhatsApp Business webhook and stores parsed personal-record messages for review. It does not create financial transactions.</p>
<% if (flash) { %><div class="flash-msg">✓ <%= flash %></div><% } %>
<form class="form-box" method="POST" action="/admin/whatsapp/settings">
<input type="hidden" name="_csrf" value="<%= csrfToken %>">
<label>Dedicated WhatsApp Business Number</label>
<input name="businessNumber" value="<%= businessNumber %>" placeholder="+91...">
<label>Testing Sender Number</label>
<input name="testNumber" value="<%= testNumber %>" placeholder="Your personal number">
<div class="mode-switch" style="margin:12px 0"><button name="enabled" value="off" class="<%= !enabled ? 'active' : '' %>">Off</button><button name="enabled" value="on" class="<%= enabled ? 'active' : '' %>">On</button></div>
<button type="submit">Save</button>
</form>

<h2 style="margin-top:32px">Category aliases</h2>
<form class="form-box" method="POST" action="/admin/whatsapp/aliases">
<input type="hidden" name="_csrf" value="<%= csrfToken %>">
<label>Category</label>
<select name="lotteryId" required><option value="">Choose category</option><% lotteries.forEach(l => { %><option value="<%= l.id %>"><%= l.name %></option><% }) %></select>
<label>Alias / common spelling</label><input name="alias" maxlength="80" placeholder="e.g. rewadi" required>
<button type="submit">Add Alias</button>
</form>
<ul><% aliases.forEach(a => { const l=lotteries.find(x=>x.id===a.lotteryId); %><li><strong><%= a.alias %></strong> → <%= l ? l.name : 'Unknown category' %> <form method="POST" action="/admin/whatsapp/aliases/<%= a.id %>/delete" style="display:inline"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button type="submit" class="btn secondary">Delete</button></form></li><% }) %></ul>

<h2 style="margin-top:32px">Incoming messages</h2>
<div style="overflow:auto"><table><thead><tr><th>Received</th><th>Sender</th><th>Message</th><th>Status</th><th>Parsed</th></tr></thead><tbody>
<% messages.slice(0,100).forEach(m => { %><tr><td><%= m.receivedAt %></td><td><%= m.senderPhone %><br><small><%= m.displayName %></small></td><td><%= m.rawText %></td><td><%= m.status %></td><td><%= m.parsed && m.parsed.ok ? (m.parsed.category.name + ' · ' + m.parsed.entries.join(', ') + (m.parsed.amount !== null ? ' · ' + m.parsed.amount : '')) : (m.parsed && m.parsed.error) || '' %></td></tr><% }) %>
<% if (!messages.length) { %><tr><td colspan="5">No messages received yet.</td></tr><% } %></tbody></table></div>
<%- include('partial-footer') %>

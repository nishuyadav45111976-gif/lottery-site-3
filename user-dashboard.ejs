<%- include('partial-header', { title: 'My Dashboard' }) %>
<div class="container">
  <div class="account-head">
    <div>
      <h1>Welcome, <%= user.name %></h1>
      <p class="subtitle">Personal ID: <strong><%= user.userCode %></strong></p>
    </div>
    <div class="top-actions-inline">
      <a class="btn secondary" href="/account/settings">Settings</a>
      <form method="post" action="/logout"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn secondary" type="submit">Logout</button></form>
    </div>
  </div>

  <% if (typeof notice !== 'undefined' && notice) { %><div class="flash-msg">✓ <%= notice %></div><% } %>
  <% if (typeof error !== 'undefined' && error) { %><div class="error-msg"><%= error %></div><% } %>

  <% if (typeof closest !== 'undefined' && closest) { %>
  <div class="card" style="padding:12px 18px; display:flex; align-items:center; justify-content:space-between; gap:10px; flex-wrap:wrap;">
    <span><strong><%= closest.lottery.name %></strong> — <%= closest.locked ? 'Closing soon' : 'Next draw' %> in <%= closest.countdownText %> <span class="subtitle" style="font-size:0.85em;">(<%= closest.lottery.drawTime %>)</span></span>
    <a class="btn primary" href="/account/numbers/<%= closest.lottery.id %>" style="white-space:nowrap;">Enter Numbers</a>
  </div>
  <% } %>

  <div class="card" id="quickUserEntry">
    <h2>Quick Ticket Entry</h2>
    <p class="subtitle">Numbers × amount, then the lottery name (the word "into" is optional) — e.g. <code>10,11,12,13×75 Rewari</code></p>
    <div class="quick-entry-row">
      <input type="text" id="quickUserInput" placeholder="10,11,12,13×75 into Rewari" autocomplete="off">
      <button type="button" class="btn primary" id="quickUserSubmit">Add</button>
    </div>
    <div class="error-msg" id="quickUserError" style="display:none;"></div>
    <form method="POST" id="quickUserForm" action="/account/quick-purchase" style="display:none;">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input type="hidden" name="lotteryId" id="quickUserLotteryId" value="">
      <input type="hidden" name="amount" id="quickUserAmount">
      <input type="hidden" name="requestId" value="<%= quickEntryRequestId %>">
      <div id="quickUserNumbersInputs"></div>
    </form>
  </div>
  <script type="application/json" id="quickUserLotteriesData"><%- JSON.stringify(lotteries.map(function(l){return {id:l.id, name:l.name};})) %></script>
  <script src="/user-quick-entry.js" defer></script>

  <div class="dashboard-nav-grid">
    <a class="dashboard-nav-card" href="/account/lotteries"><strong>Choose Lottery</strong><span>Open a lottery and enter ticket details</span></a>
    <a class="dashboard-nav-card" href="/account/tickets"><strong>My Tickets</strong><span>View your ticket history and totals</span></a>
  </div>

  <div class="card">
    <div class="section-head-row"><h2>Your ticket summary</h2><a class="btn secondary" href="/account/tickets">View My Tickets</a></div>
    <p class="subtitle">Your ticket totals are tied to your account and are private to you.</p>
  </div>
</div>
<%- include('partial-footer') %>

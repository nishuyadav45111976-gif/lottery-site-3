<%- include('partial-header', { title: lottery.name + ' — Ticket Purchases' , isAdminPage: true }) %>

<a class="back-link" href="/admin">&larr; Dashboard</a>
<h1><%= lottery.name %> &mdash; Number Records</h1>
<p class="subtitle">Your existing internal ticket records are shown here. User-followed numbers are also shown separately so you can see which account is watching each number.</p>

<% if (typeof flash !== 'undefined' && flash) { %>
  <div class="flash-msg">✓ <%= flash %></div>
<% } %>

<a class="btn secondary" style="margin:12px 0 20px;" href="/admin/lottery/<%= lottery.id %>/purchases/export.csv">Export Ticket Records as CSV</a>

<div class="card" id="quickAdminEntry" data-lottery-id="<%= lottery.id %>">
  <h2>Quick Ticket Entry</h2>
  <p class="subtitle">Numbers × amount for <%= lottery.name %> — e.g. <code>10,11,12,13,51,71,78,98×75</code>. You can still type "into &lt;name&gt;" to send it to a different lottery instead.</p>
  <div class="quick-entry-row">
    <input type="text" id="quickAdminInput" placeholder="10,11,12,13,51,71,78,98×75" autocomplete="off">
    <button type="button" class="btn primary" id="quickAdminSubmit">Add</button>
  </div>
  <div class="error-msg" id="quickAdminError" style="display:none;"></div>
  <form method="POST" id="quickAdminForm" action="/admin/quick-purchase" style="display:none;">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <input type="hidden" name="lotteryId" id="quickAdminLotteryId" value="<%= lottery.id %>">
    <input type="hidden" name="amount" id="quickAdminAmount">
    <input type="hidden" name="returnTo" value="lottery">
    <div id="quickAdminNumbersInputs"></div>
  </form>
</div>
<script type="application/json" id="quickAdminLotteriesData"><%- JSON.stringify((allLotteries || []).map(function(l){return {id:l.id, name:l.name};})) %></script>
<script src="/admin-quick-entry.js" defer></script>

<div class="number-grid">
  <% numbers.forEach(function(n) { %>
    <a class="number-box <%= (totals[n].tickets > 0 || totals[n].followers > 0) ? 'has-entries' : '' %>" href="/admin/lottery/<%= lottery.id %>/purchases/<%= n %>">
      <div class="num-label"><%= n %></div>
      <% if (totals[n].tickets > 0) { %>
        <div class="num-meta"><%= totals[n].tickets %> tkt<%= totals[n].tickets === 1 ? '' : 's' %></div>
      <% } %>
      <% if (totals[n].amount > 0) { %>
        <div class="num-meta"><%= totals[n].amount %></div>
      <% } %>
      <% if (totals[n].followers > 0) { %>
        <div class="num-meta follower-meta"><%= totals[n].followers %> user<%= totals[n].followers === 1 ? '' : 's' %> following</div>
      <% } %>
    </a>
  <% }); %>
</div>

<%- include('partial-footer') %>

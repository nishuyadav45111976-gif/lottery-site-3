<%- include('partial-header', { title: 'Edit Pages' , isAdminPage: true }) %>

<a class="back-link" href="/billionaire">&larr; Dashboard</a>
<h1>Edit Pages</h1>
<p class="subtitle">Change your website name and the text shown on your Disclaimer, Privacy Policy, and About pages — no code changes needed, updates go live as soon as you save.</p>

<% if (typeof flash !== 'undefined' && flash) { %>
  <div class="flash-msg">✓ <%= flash %></div>
<% } %>

<% if (error) { %>
  <div class="error-msg"><%= error %></div>
<% } %>

<div class="card">
  <h2 style="margin-top:0;">Site Logo</h2>
  <p class="subtitle">Shown next to your site name in the header — on the public site and here in the admin panel.</p>

  <div style="display:flex; align-items:center; gap:12px; margin-bottom:18px;">
    <span class="subtitle" style="margin:0;">Current:</span>
    <% if (siteLogoType === 'image' && siteLogoImageData) { %>
      <img src="<%= siteLogoImageData %>" alt="" style="height:36px; width:auto; max-width:60px; border-radius:6px; object-fit:contain;">
    <% } else { %>
      <span style="font-size:1.8rem;"><%= siteLogoEmoji %></span>
    <% } %>
  </div>

  <form method="POST" action="/billionaire/pages/logo" enctype="multipart/form-data">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">

    <label style="font-weight:600;"><input type="radio" name="logoType" value="emoji" <%= siteLogoType !== 'image' ? 'checked' : '' %> onchange="document.getElementById('logoEmojiField').style.display='block';document.getElementById('logoImageField').style.display='none';"> Emoji or short text</label>
    <label style="font-weight:600; margin-left:20px;"><input type="radio" name="logoType" value="image" <%= siteLogoType === 'image' ? 'checked' : '' %> onchange="document.getElementById('logoEmojiField').style.display='none';document.getElementById('logoImageField').style.display='block';"> Uploaded image</label>

    <div id="logoEmojiField" style="margin-top:16px; <%= siteLogoType === 'image' ? 'display:none;' : '' %>">
      <label for="logoEmoji">Emoji or short text</label>
      <input type="text" id="logoEmoji" name="logoEmoji" value="<%= siteLogoEmoji %>" maxlength="8" style="width:120px;" />
    </div>

    <div id="logoImageField" style="margin-top:16px; <%= siteLogoType === 'image' ? '' : 'display:none;' %>">
      <label for="logoImage">Upload image (PNG, JPG, WEBP, or SVG — under 1&nbsp;MB)</label>
      <input type="file" id="logoImage" name="logoImage" accept="image/png,image/jpeg,image/webp,image/svg+xml" />
    </div>

    <button type="submit" style="margin-top:18px;">Save Logo</button>
  </form>
</div>

<form class="form-box" method="POST" action="/billionaire/pages"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <label for="siteName">Website Name</label>
  <input type="text" id="siteName" name="siteName" value="<%= currentName %>" required />

  <label for="areaServed" style="margin-top:16px;">Area Served <span style="font-weight:400;">(optional — e.g. "Haryana, India")</span></label>
  <p class="subtitle" style="margin-top:-4px;">Tells search engines what region this site is relevant to. Leave blank if not applicable.</p>
  <input type="text" id="areaServed" name="areaServed" value="<%= currentAreaServed %>" placeholder="e.g. Haryana, India" />

  <label for="disclaimerText" style="margin-top:20px;">Disclaimer page content</label>
  <p class="subtitle" style="margin-top:-4px;">Shown at <code>/disclaimer</code>. Leave a blank line between paragraphs.</p>
  <textarea id="disclaimerText" name="disclaimerText" rows="6" style="width:100%; font:inherit; padding:10px; border-radius:8px;"><%= disclaimerText %></textarea>

  <label for="privacyText" style="margin-top:20px;">Privacy Policy & Terms content</label>
  <p class="subtitle" style="margin-top:-4px;">Shown at <code>/privacy</code>.</p>
  <textarea id="privacyText" name="privacyText" rows="6" style="width:100%; font:inherit; padding:10px; border-radius:8px;"><%= privacyText %></textarea>

  <label for="aboutText" style="margin-top:20px;">About / Contact page content</label>
  <p class="subtitle" style="margin-top:-4px;">Shown at <code>/about</code>.</p>
  <textarea id="aboutText" name="aboutText" rows="6" style="width:100%; font:inherit; padding:10px; border-radius:8px;"><%= aboutText %></textarea>

  <label for="faqText" style="margin-top:20px;">FAQ page content</label>
  <p class="subtitle" style="margin-top:-4px;">Shown at <code>/faq</code>. Write each question on its own line, followed by the answer on the next line, with a blank line between each Q&amp;A.</p>
  <textarea id="faqText" name="faqText" rows="8" style="width:100%; font:inherit; padding:10px; border-radius:8px;"><%= faqText %></textarea>

  <button type="submit" style="margin-top:18px;">Save Pages</button>
</form>

<%- include('partial-footer') %>

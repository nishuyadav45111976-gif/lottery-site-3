<%- include('partial-header', { title: 'Settings' }) %>
<div class="container">
  <div class="page-back"><a href="/account">← Back to Dashboard</a></div>
  <div class="top-actions"><h1 style="margin:0;">Settings</h1><a class="btn secondary" href="/account/lotteries">Lotteries</a></div>
  <% if (notice) { %><div class="flash-msg">✓ <%= notice %></div><% } %>
  <% if (error) { %><div class="error-msg"><%= error %></div><% } %>

  <div class="card">
    <div class="account-setting-head">
      <div><h2 style="margin:0;">Notifications</h2><p class="subtitle">Get an in-account and browser notification when a published result contains a number you follow.</p></div>
      <form method="post" action="/account/settings/notifications" class="notification-toggle-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <label class="switch-label"><input type="checkbox" name="enabled" <%= user.notificationsEnabled !== false ? 'checked' : '' %> onchange="this.form.submit()" /><span class="switch"></span><span><%= user.notificationsEnabled !== false ? 'On' : 'Off' %></span></label>
      </form>
    </div>
    <div id="pushStatus" class="subtitle" style="margin-top:12px;"></div>
  </div>

  <div class="card">
    <h2>Change Password</h2>
    <p class="subtitle">Choose a new password for your personal account.</p>
    <form class="form-box compact-form" method="post" action="/account/settings/password"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <label>Current password</label><input type="password" name="currentPassword" required autocomplete="current-password" />
      <label>New password</label><input type="password" name="newPassword" minlength="8" required autocomplete="new-password" />
      <label>Confirm new password</label><input type="password" name="confirmPassword" minlength="8" required autocomplete="new-password" />
      <button class="btn primary" type="submit">Change Password</button>
    </form>
  </div>
</div>
<script>
(function () {
  var enabled = <%= user.notificationsEnabled !== false ? 'true' : 'false' %>;
  var status = document.getElementById('pushStatus');
  if (!enabled || !('Notification' in window)) return;
  if (Notification.permission === 'granted') { if (status) status.textContent = 'Browser notifications are allowed on this device.'; setupPushSubscription(); return; }
  if (Notification.permission === 'denied') { if (status) status.textContent = 'Browser notifications are blocked in your browser settings. In-account notifications will still be saved.'; return; }
  var askedKey = 'resultNotificationsPermissionAsked';
  if (!localStorage.getItem(askedKey)) {
    setTimeout(function () { Notification.requestPermission().then(function (permission) { localStorage.setItem(askedKey, '1'); if (status) status.textContent = permission === 'granted' ? 'Browser notifications are now enabled.' : 'Browser permission was not granted. In-account notifications will still be saved.'; if (permission === 'granted') setupPushSubscription(); }).catch(function () {}); }, 500);
  }
  function urlBase64ToUint8Array(base64String) { var padding = '='.repeat((4 - base64String.length % 4) % 4); var rawData = window.atob((base64String + padding).replace(/-/g, '+').replace(/_/g, '/')); var outputArray = new Uint8Array(rawData.length); for (var i = 0; i < rawData.length; ++i) outputArray[i] = rawData.charCodeAt(i); return outputArray; }
  function setupPushSubscription() { if (!('serviceWorker' in navigator) || !('PushManager' in window)) return; fetch('/notifications/public-key').then(function(r){if(!r.ok) throw new Error(); return r.json();}).then(function(data){return navigator.serviceWorker.ready.then(function(reg){return reg.pushManager.getSubscription().then(function(existing){return existing || reg.pushManager.subscribe({userVisibleOnly:true,applicationServerKey:urlBase64ToUint8Array(data.publicKey)});});});}).then(function(subscription){return fetch('/notifications/subscribe',{method:'POST',headers:{'Content-Type':'application/json','X-CSRF-Token':'<%= csrfToken %>'},body:JSON.stringify({subscription:subscription.toJSON()})});}).catch(function(){}); }
})();
</script>
<%- include('partial-footer') %>

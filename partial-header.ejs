<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <title><%= (typeof title !== 'undefined' && title && title !== siteName) ? title + ' | ' + siteName : siteName %></title>
  <% if (noIndex) { %><meta name="robots" content="noindex,nofollow,noarchive" /><% } %>
  <meta name="description" content="<%= typeof metaDescription !== 'undefined' && metaDescription ? metaDescription : siteName + ' — latest lottery results, updated daily.' %>" />
  <meta property="og:type" content="website" />
  <meta property="og:title" content="<%= (typeof title !== 'undefined' && title) ? title : siteName %>" />
  <meta property="og:description" content="<%= typeof metaDescription !== 'undefined' && metaDescription ? metaDescription : siteName + ' — latest lottery results, updated daily.' %>" />
  <% if (typeof currentUrl !== 'undefined' && currentUrl) { %><meta property="og:url" content="<%= currentUrl %>" /><% } %>
  <meta name="twitter:card" content="summary" />
  <meta name="twitter:title" content="<%= (typeof title !== 'undefined' && title) ? title : siteName %>" />
  <meta name="twitter:description" content="<%= typeof metaDescription !== 'undefined' && metaDescription ? metaDescription : siteName + ' — latest lottery results, updated daily.' %>" />
  <% if (!noIndex && currentUrl) { %><link rel="canonical" href="<%= currentUrl %>" /><% } %>
  <meta name="theme-color" content="<%= (typeof isAdminPage !== 'undefined' && isAdminPage) ? '#6B4A32' : '#1a9c6b' %>" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="apple-touch-icon" href="<%= (typeof isAdminPage !== 'undefined' && isAdminPage) ? '/icon-192.png' : '/favicon.svg' %>" />
  <link rel="manifest" href="<%= (typeof isAdminPage !== 'undefined' && isAdminPage) ? '/admin-manifest.json' : '/manifest.json' %>" />
  <script>
    // Applied before the stylesheet loads, so there's no flash of the wrong theme
    (function () {
      try {
        var saved = localStorage.getItem('theme');
        if (saved === 'dark') document.documentElement.setAttribute('data-theme', 'dark');
      } catch (e) {}
    })();
  </script>
  <link rel="stylesheet" href="/style.css" />
</head>
<a class="skip-link" href="#main-content">Skip to content</a>
<body class="<%= (typeof contactNumber !== 'undefined' && contactNumber) ? 'has-contact-bar' : '' %> <%= (typeof isAdminPage !== 'undefined' && isAdminPage) ? 'admin-theme' : '' %>">
  <% if (typeof isAdminPage !== 'undefined' && isAdminPage) { %>
  <header class="site-header admin-topbar">
    <div class="container">
      <a href="/admin" class="logo admin-brand"><span class="admin-brand-mark raised-sm">🏆</span> <span><span class="brand-title-text"><%= siteName %></span><span class="brand-sub-text">Admin Panel</span></span></a>
      <% if (!(typeof hideAdminNav !== 'undefined' && hideAdminNav)) { %>
      <button id="mobileNavToggle" class="mobile-nav-toggle" type="button" aria-label="Open navigation" aria-expanded="false">☰</button><nav id="siteNav">
        <a href="/admin">Dashboard</a>
        <a href="/admin/users">Users</a>
        <a href="/admin/stats">Reports</a>
        <a href="/admin/hub">Settings</a>
        <a href="/" target="_blank" rel="noopener">View Site</a>
        <form method="post" action="/admin/logout" style="display:inline;"><input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>"><button type="submit" class="lang-toggle" style="background:transparent; cursor:pointer;">Log Out</button></form>
      </nav>
      <div class="header-actions">
        <button id="themeToggleBtn" type="button" class="theme-toggle" aria-label="Toggle dark mode" title="Toggle dark mode">🌙</button>
        <a class="icon-btn" href="/admin/audit-log" aria-label="Recent activity">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>
          <% if (typeof recentActivity !== 'undefined' && recentActivity && recentActivity.length) { %><span class="badge"><%= recentActivity.length %></span><% } %>
        </a>
        <button type="button" class="avatar" aria-label="Admin profile" onclick="openAdminSheet('profile')">A</button>
      </div>
      <% } %>
    </div>
  </header>
  <% if (typeof enableAdminInstall !== 'undefined' && enableAdminInstall) { %>
    <div id="installAppBar" class="install-app-bar" style="display:none;">
      <button id="installAppBtn" class="btn secondary" type="button">📲 Install Admin App</button>
    </div>
  <% } %>
  <% } else { %>
  <header class="site-header">
    <div class="container">
      <a href="/" class="logo">🏆 <%= siteName %></a>
      <button id="mobileNavToggle" class="mobile-nav-toggle" type="button" aria-label="Open navigation" aria-expanded="false">☰</button><nav id="siteNav">
        <a href="/"><%= t('navResults') %></a>
        <a href="/history"><%= t('navHistory') %></a>
        <% if (typeof userSession !== 'undefined' && userSession) { %>
          <a href="/account">My Account</a>
        <% } %>
        <a href="/lang/<%= lang === 'hi' ? 'en' : 'hi' %>" class="lang-toggle"><%= t('langToggle') %></a>
        <a href="/disclaimer">Disclaimer</a>
        <a href="/privacy">Privacy Policy</a>
        <a href="/about">About / Contact</a>
        <a href="/faq">FAQ</a>
        <button id="themeToggleBtn" type="button" class="lang-toggle" style="background:transparent; cursor:pointer;">🌙</button>
      </nav>
    </div>
    <% if (typeof hasSpecialLotteries !== 'undefined' && hasSpecialLotteries) { %>
      <a href="/special" class="special-header-link">🎰 Special Lottery <span>›</span></a>
    <% } %>
  </header>
  <% } %>

  <% if (typeof isHomePage !== 'undefined' && isHomePage && typeof specialLotteries !== 'undefined' && specialLotteries.length > 0) { %>
    <div class="special-section">
      <p class="special-section-heading">🎰 Special Lottery <span style="font-size:0.7rem; font-weight:600; opacity:0.7;">000–999</span></p>
      <p class="special-section-sub">A separate set of lotteries with 3-digit numbers.</p>

      <% if (starredSpecialLottery) { %>
        <div class="featured-box special">
          <div class="featured-label">⭐ Featured Special</div>
          <div class="featured-name"><%= starredSpecialLottery.name %></div>
          <% if (starredSpecialLottery.drawTime) { %><div class="featured-time"><%= starredSpecialLottery.drawTime %></div><% } %>
          <div class="featured-result <%= starredSpecialLottery.latestResult ? '' : 'pending' %>">
            <%= starredSpecialLottery.latestResult ? starredSpecialLottery.latestResult.resultText : 'Result pending' %>
            <% if (starredSpecialLottery.latestResult) { %><span class="featured-date"><%= starredSpecialLottery.latestResult.date %></span><% } else if (starredSpecialLottery.upcoming) { %>
              <span class="featured-date"><%= starredSpecialLottery.upcoming.pendingResult ? '' : 'Today · ' + starredSpecialLottery.upcoming.remainingText + ' left' %></span>
            <% } %>
          </div>
        </div>
      <% } %>

      <div class="card-grid special-grid">
        <% specialLotteries.forEach(function(lottery) { %>
          <a class="lottery-card special-card" href="/special/<%= lottery.slug %>">
            <div><span class="special-chip">Special</span></div>
            <div class="name"><%= lottery.starred ? '⭐ ' : '' %><%= lottery.name %></div>
            <% if (lottery.latestResult) { %>
              <div class="result"><%= lottery.latestResult.resultText %></div>
              <div class="date">Latest · <%= lottery.latestResult.date %></div>
            <% } else if (lottery.upcoming) { %>
              <div class="no-result"><%= lottery.upcoming.pendingResult ? 'Result pending' : ('Upcoming · ' + lottery.upcoming.drawTime) %></div>
            <% } else { %>
              <div class="no-result">No result yet</div>
            <% } %>
          </a>
        <% }); %>
      </div>
    </div>
  <% } %>

  <div id="navProgressBar" aria-hidden="true"></div>
  <script>
    // A thin bar across the top while a new page is loading, so navigating
    // between pages doesn't feel like nothing is happening.
    (function () {
      var bar = document.getElementById('navProgressBar');
      if (!bar) return;
      bar.style.cssText = 'position:fixed; top:0; left:0; height:3px; width:0%; background:#1a9c6b; z-index:9999; transition:width 0.2s ease-out;';
      document.addEventListener('click', function (e) {
        var link = e.target.closest && e.target.closest('a[href]');
        if (!link) return;
        var href = link.getAttribute('href') || '';
        if (href.startsWith('#') || href.startsWith('http') || link.target === '_blank' || href.startsWith('mailto:') || href.startsWith('tel:')) return;
        bar.style.width = '70%';
      });
      document.addEventListener('submit', function () {
        bar.style.width = '70%';
      });
      window.addEventListener('pageshow', function () {
        bar.style.width = '0%';
      });
    })();
  </script>

  <% if (typeof enableServiceWorker !== 'undefined' && enableServiceWorker) { %>
    <div id="installAppBar" class="install-app-bar" style="display:none;">
      <button id="installAppBtn" class="btn secondary" type="button">📲 Install App</button>
    </div>
  <% } %>

  <main id="main-content" class="container">

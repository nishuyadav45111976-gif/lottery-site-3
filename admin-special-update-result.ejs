<%- include('partial-header', { title: 'Update Result - ' + lottery.name , isAdminPage: true }) %>

<a class="back-link" href="/admin/special">&larr; Special Lottery</a>
<h1><%= lottery.name %> <span class="tag tag-soft">Special</span></h1>
<p class="subtitle">Add today's result, or update any past date (posting the same date again overwrites it). Numbers 000–999.</p>

<% if (typeof flash !== 'undefined' && flash) { %>
  <div class="flash-msg">✓ <%= flash %></div>
<% } %>

<% if (error) { %>
  <div class="error-msg"><%= error %></div>
<% } %>

<form class="form-box" method="POST" action="/admin/special/lottery/<%= lottery.id %>/result"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <label for="date">Result date</label><p class="subtitle">Use today or an earlier date. Future result dates are not allowed.</p>
  <input type="date" id="date" name="date" required />

  <label for="resultText">Result</label>
  <input type="text" id="resultText" name="resultText" placeholder="e.g. 458 127 903" required />

  <% if (lottery.drawTime) { %>
    <label style="margin-top:14px;">When should this go live?</label>
    <p class="subtitle" style="margin-top:-4px;">If you're entering today's result during the closing window, you can hold it back until the official draw time (<%= lottery.drawTime %>) instead of publishing it right away.</p>
    <label style="display:flex; align-items:center; gap:8px; font-weight:normal;">
      <input type="radio" name="publishMode" value="now" checked style="width:auto;" /> Publish immediately
    </label>
    <label style="display:flex; align-items:center; gap:8px; font-weight:normal; margin-top:6px;">
      <input type="radio" name="publishMode" value="schedule" style="width:auto;" /> Save now, go live automatically at <%= lottery.drawTime %> (today's date only)
    </label>
  <% } %>

  <button type="submit" style="margin-top:14px;">Save Result</button>
</form>

<h2 style="margin-top:32px;">Result History</h2>
<a class="btn secondary" style="margin-bottom:12px;" href="/admin/special/lottery/<%= lottery.id %>/results/export.csv">Export Results as CSV</a>
<% if (results.length === 0) { %>
  <div class="empty-state">No results posted yet.</div>
<% } else { %>
  <div class="table-scroll-wrap">
  <table>
    <thead><tr><th>Date</th><th>Result</th><th></th></tr></thead>
    <tbody>
      <% results.forEach(function(r) { %>
        <tr>
          <td><%= r.date %></td>
          <td class="result-cell">
            <%= r.resultText %>
            <% if (r.published === false) { %>
              <div style="font-size:0.78rem; color:#b8860b; margin-top:2px;">⏳ Scheduled — not public yet, <%= r.scheduledCountdown || 'goes live automatically at draw time' %></div>
            <% } %>
          </td>
          <td>
            <form method="POST" action="/admin/special/lottery/<%= lottery.id %>/result/<%= r.id %>/delete" onsubmit="return confirm('Delete this result? You can undo it from the trash below.');"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button type="submit" class="btn danger">Delete</button>
            </form>
          </td>
        </tr>
      <% }); %>
    </tbody>
  </table>
  </div>
<% } %>

<% if (trashedResults && trashedResults.length > 0) { %>
  <h2 style="margin-top:32px;">Trash</h2>
  <p class="subtitle">Deleted results stay here until you restore or permanently remove them.</p>
  <div class="table-scroll-wrap">
  <table>
    <thead><tr><th>Date</th><th>Result</th><th></th></tr></thead>
    <tbody>
      <% trashedResults.forEach(function(r) { %>
        <tr>
          <td><%= r.date %></td>
          <td class="result-cell"><%= r.resultText %></td>
          <td style="display:flex; gap:6px;">
            <form method="POST" action="/admin/special/lottery/<%= lottery.id %>/result/<%= r.id %>/restore"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button type="submit" class="btn secondary">Restore</button>
            </form>
            <form method="POST" action="/admin/special/lottery/<%= lottery.id %>/result/<%= r.id %>/purge" onsubmit="return confirm('Permanently delete this result? This cannot be undone.');"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button type="submit" class="btn danger">Delete Forever</button>
            </form>
          </td>
        </tr>
      <% }); %>
    </tbody>
  </table>
  </div>
<% } %>

<%- include('partial-footer') %>
